# Топик с 3 партициями и репликацией на все 3 брокера
docker exec -it kafka1 kafka-topics --create \
  --bootstrap-server kafka1:19092 \
  --topic test-topic \
  --partitions 3 \
  --replication-factor 3

# Проверить что создался
docker exec -it kafka1 kafka-topics --list \
  --bootstrap-server kafka1:19092

# Подробная инфо о топике
docker exec -it kafka1 kafka-topics --describe \
  --bootstrap-server kafka1:19092 \
  --topic test-topic


  

# Открываем producer — пишем сообщения, каждая строка = одно сообщение
docker exec -it kafka1 kafka-console-producer \
  --bootstrap-server kafka1:19092 \
  --topic test-topic
