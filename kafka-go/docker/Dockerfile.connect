FROM golang:1.22-alpine AS builder

WORKDIR /app

# Копируем go.mod и go.sum
COPY go.mod go.sum ./
RUN go mod download

# Копируем исходный код
COPY . .

# Собираем connect-deploy
RUN go build -o connect-deploy ./connect/deploy.go

# Финальный образ
FROM alpine:latest

RUN apk --no-cache add ca-certificates curl

WORKDIR /root/

# Копируем бинарник из builder
COPY --from=builder /app/connect-deploy .

# Запускаем
CMD ["./connect-deploy"]
